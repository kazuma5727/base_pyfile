{
    "profile": {
        "id": "cpu",
        "description": "CPUのみ（Intel Core i7-8665U / 16GB RAM）向け。Ollamaの軽量モデルだけで動作する。",
        "hardware": "Intel Core i7-8665U (4C/8T), 16GB RAM, integrated GPU",
        "policy": "local-only; no cloud fallback",
        "required_models": [
            "tev1:0.8b",
            "qwen2.5:0.5b",
            "qwen2.5-coder:3b",
            "deepseek-r1:1.5b"
        ],
        "optional_models": [
            "qwen2.5:1.5b"
        ],
        "cloud": false
    },
    "router": {
        "preferred": "tev1:0.8b",
        "fallback": ["qwen2.5:0.5b", "qwen2.5:1.5b", "qwen2.5-coder:3b"],
        "safe_target": "deepseek-r1:1.5b",
        "default_target": "qwen2.5:0.5b"
    },
    "correction": {
        "min_chars": 1,
        "tiers": [
            { "max_chars": 80, "model": "qwen2.5:0.5b" },
            { "max_chars": 800, "model": "qwen2.5:1.5b" },
            { "max_chars": 3000, "model": "qwen2.5-coder:3b" },
            { "max_chars": null, "model": "qwen2.5-coder:3b" }
        ],
        "fallback": ["qwen2.5-coder:3b", "deepseek-r1:1.5b", "qwen2.5:0.5b"]
    },
    "translation": {
        "min_chars": 1,
        "target_language": "ja",
        "tiers": [
            { "max_chars": 200, "model": "qwen2.5:0.5b" },
            { "max_chars": 1200, "model": "qwen2.5:1.5b" },
            { "max_chars": 4000, "model": "qwen2.5-coder:3b" },
            { "max_chars": null, "model": "qwen2.5-coder:3b" }
        ],
        "fallback": ["qwen2.5-coder:3b", "deepseek-r1:1.5b", "qwen2.5:0.5b"]
    },
    "agent": {
        "model": "qwen2.5-coder:3b",
        "fallback": ["qwen2.5:1.5b", "deepseek-r1:1.5b", "qwen2.5:0.5b"],
        "max_steps": 4,
        "execute": "subprocess",
        "work_dir": "workspace",
        "timeout": 180
    },
    "models": [
        {
            "name": "tev1:0.8b",
            "role": "router",
            "description": "超軽量の振り分け専用モデル。CPUでも待ち時間が少ない。",
            "strengths": ["高速", "低メモリ", "日本語の短い指示"],
            "weaknesses": ["長文生成", "複雑な推論"],
            "best_for": ["LLMの振り分け", "短い質問の判断", "簡単な回答"],
            "avoid_for": ["長文生成", "コード生成", "数学・論理推論"]
        },
        {
            "name": "qwen2.5:0.5b",
            "role": "light",
            "description": "最短の校正・翻訳向け。CPUで最も速い一般モデル。",
            "strengths": ["高速", "低メモリ", "短い文章"],
            "weaknesses": ["長文", "高度な推論", "専門知識"],
            "best_for": ["簡単な質問応答", "短い文章の整形", "ルーターの代替"],
            "avoid_for": ["難しい推論", "コード生成", "長文"]
        },
        {
            "name": "qwen2.5:1.5b",
            "role": "light_general",
            "description": "CPU向けの推奨追加モデル。0.5Bより自然な日本語で、3Bより軽い。",
            "strengths": ["日本語", "校正", "翻訳", "バランス"],
            "weaknesses": ["長文", "高度な推論"],
            "best_for": ["短い校正", "短い翻訳", "日本語の文章", "簡単な質問"],
            "avoid_for": ["長文", "コード生成", "高度な推論"]
        },
        {
            "name": "qwen2.5-coder:3b",
            "role": "code",
            "description": "CPUで動くコード向けモデル。長めの文章や技術文書の処理にも使う。",
            "strengths": ["コード", "技術文書", "論理的な整形"],
            "weaknesses": ["日本語の自然さ", "創作"],
            "best_for": ["コード生成", "コード説明", "技術文書の整形", "長めの文章処理"],
            "avoid_for": ["創作", "日本語の自然な校正", "高度な推論"]
        },
        {
            "name": "deepseek-r1:1.5b",
            "role": "reasoning",
            "description": "軽量な推論モデル。安全側の判断や短い分析向け。",
            "strengths": ["推論", "段階的な説明", "低メモリ"],
            "weaknesses": ["速度", "長文生成", "思考過程の出力"],
            "best_for": ["段階的な推論", "数学・論理", "安全側の判断"],
            "avoid_for": ["高速応答", "長文生成", "コーディング"]
        }
    ]
}
